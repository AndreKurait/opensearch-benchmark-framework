+class _Recording(io.BytesIO):
+    """A recorded byte stream that survives being read as an HTTP response.
+
+    `HTTPResponse` closes its file object the moment the body is exhausted, and several responses can share one
+    recording (a retry that reused the connection), so `close` is a no-op here and the read position is what
+    carries the parse forward."""
+
+    def close(self):                                       # noqa: D102 - see the class docstring
+        pass
+
+
+class _ReplaySocket:
+    """Enough of a socket for `http.client.HTTPResponse`, which only ever calls `makefile("rb")` on it."""
+
+    def __init__(self, recording):
+        self._recording = recording
+
+    def makefile(self, *_args, **_kwargs):
+        return self._recording
+
+
+def _http_responses(raw):
+    """Every complete HTTP response in ``raw``, oldest first, as ``(status, headers, body)`` with the body
+    CONTENT-DECODED.
+
+    Parsed with the stdlib rather than by hand: framing (the status line, the header block, `Content-Length` vs
+    `Transfer-Encoding: chunked`) is `http.client`'s job, and re-implementing it in a test is how a test starts
+    asserting on its own parser instead of on the service."""
+    recording = _Recording(raw)
+    answers = []
+    while recording.tell() < len(raw):
+        if raw[recording.tell():].strip(b"\r\n") == b"":    # trailing CRLF after the last body
+            break
+        response = HTTPResponse(_ReplaySocket(recording))
+        response.begin()
+        headers = {key.lower(): value for key, value in response.getheaders()}
+        answers.append((response.status, headers, _content_decoded(headers, response.read())))
+    assert answers, f"no HTTP response could be parsed out of {len(raw)} recorded byte(s): {raw[:200]!r}"
+    return answers
+
+
+def _content_decoded(headers, body):
+    """``body`` with the `Content-Encoding` the response DECLARES undone — never guessed, and never skipped.
+
+    THIS IS THE REASON THIS HELPER EXISTS. RM's Legos client runs on `requests` (`coral.httphandler` uses a
+    `requests.Session`), which advertises `Accept-Encoding: gzip, deflate` and transparently decompresses
+    `.content` — and `LegosClient.__init__` even passes `signature_ignore_headers=["accept-encoding"]` so that
+    header stays out of the SigV4 signature. Legos' Coral server honours it. Measured on the successful
+    `CreateResources` in this suite: `Content-Type: application/json`, `Content-Encoding: gzip`,
+    `Content-Length: 352`. So the CLIENT sees JSON while the teed socket carries DEFLATE bytes, and a test that
+    greps the raw capture for a field name fails on a perfectly good answer (and could pass on the wrong one by
+    coincidence).
+
+    `amz-1.0` is passed through deliberately: it is CoralRPCv1's protocol marker (the client sets it on the
+    REQUEST), not a compression."""
+    encoding = headers.get("content-encoding", "identity").strip().lower()
+    if encoding in ("identity", "", "amz-1.0"):
+        return body
+    if encoding in ("gzip", "x-gzip"):
+        return gzip.decompress(body)
+    if encoding == "deflate":
+        # Both spellings are in the wild: zlib-wrapped (RFC 1950) and raw deflate (RFC 1951).
+        try:
+            return zlib.decompress(body)
+        except zlib.error:
+            return zlib.decompress(body, -zlib.MAX_WBITS)
+    raise AssertionError(
+        f"the peer answered with an undecoded Content-Encoding {encoding!r}; extend `_content_decoded` rather "
+        f"than asserting on the raw bytes, which are not text: {body[:80]!r}")
+
+
+def _peer_answer(exchange):
+    """The peer's LAST HTTP answer on the connection that carried the Legos RPC: ``(status, headers, text)``.
