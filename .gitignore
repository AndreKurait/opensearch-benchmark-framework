# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Generated k8s manifests (reproducible from specs.json + generate.py)
k8s/generated/

# Per-region terraform state dirs and run logs created by run-all.sh. State is
# kept per-region so concurrent regions cannot corrupt a shared state file.
.runs/
.terraform-plugin-cache/
logs/

# Secrets
*.pem
*.key
.env

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# NOTE: results/ is deliberately NOT ignored.
# Raw OSB CSV, logs and probe output are committed so that every published
# number can be audited -- error rates, doc-count verification, and whether the
# workload parameters actually took effect. The previous revision ignored these
# files, which made its report unverifiable.

# Unrelated repo that exists inside this working dir; never ours to commit.
wt-base/
base/

# Stray build/probe artefacts from other work in this directory.
*.log
ca.cnf
probe/
libtest/
ca/
